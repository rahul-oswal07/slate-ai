# Copy to .env and fill in. Never commit .env.
ConnectionStrings__Db=Host=localhost;Port=5432;Database=slateai;Username=slateai;Password=slateai

# AI: set Ai__Provider=Fake to run without keys
Ai__Provider=Claude
Anthropic__ApiKey=
# Optional model overrides (defaults in appsettings.json)
# Ai__Models__Script=claude-opus-5-5
# Ai__Models__Mapping=claude-sonnet-5-5
# Ai__Models__Check=claude-haiku-5-5

# Speech (Sarvam AI)
Sarvam__ApiKey=

# Storage: Local or AzureBlob
Storage__Mode=Local
Storage__AzureBlob__ConnectionString=

# WhatsApp Cloud API (stretch)
WhatsApp__Token=
WhatsApp__PhoneNumberId=

Demo__Enabled=true
