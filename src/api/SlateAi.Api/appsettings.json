{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true,
    "SeedFile": "data/seed/demo-class.json"
  },
  "Attendance": {
    "Sats": { "AbsenceRate": 0 }
  },
  "Curriculum": {
    "Directory": "data/curriculum"
  },
  "Ai": {
    "Provider": "Claude",
    "PromptsDirectory": "prompts",
    "Models": {
      "Mapping": "claude-sonnet-5-5",
      "Compression": "claude-sonnet-5-5",
      "Script": "claude-opus-5-5",
      "Check": "claude-haiku-5-5"
    }
  },
  "Verifier": {
    "MaxScriptSeconds": 90,
    "MaxAudioSeconds": 95,
    "MaxAudioKb": 300,
    "WordsPerSecond": { "kn": 1.8, "te": 1.85, "ta": 1.9, "en": 2.2 }
  },
  "Sarvam": {
    "BaseUrl": "https://api.sarvam.ai/",
    "SttModel": "saaras:v4",
    "TtsModel": "bulbul:v3",
    "TtsSpeaker": "priya",
    "TtsSampleRate": 16000
  }
}
